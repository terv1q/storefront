# Configuration for a deployed API.
#
# Every value here is read by `server/src/config/env.ts` and validated at
# startup, so a missing or malformed one stops the process with a message that
# names it instead of failing later inside a request. This file is the reference
# for what a deployment sets; the real values belong in the platform's own
# secret store rather than in a file on disk.
#
# Two of them have no safe default and the server refuses to start in production
# without them: `DATABASE_URL` and a `JWT_SECRET` that is not the example.

# development | test | production. In production the server asserts its signing
# secret is not the example value and is at least 32 characters long.
NODE_ENV=production

# Port the API listens on. A platform that injects its own port sets it here.
PORT=4000

# The database, including its credentials. A deployment should give the API its
# own role with rights on one database and no others, rather than the owner role
# the migrations use.
DATABASE_URL=postgresql://user:password@host:5432/storefront?schema=public

# Signs every access token. At least 32 characters in production. Generate one
# with `openssl rand -base64 48`, keep it in the platform's secret store, and
# rotate it knowing that rotation signs everybody out.
JWT_SECRET=

# Lifetime of an access token: a number of seconds, or a value like 30s, 15m,
# 12h, 7d, 2w. There is no refresh token in this version, so this is also how
# long a stolen token is worth stealing.
JWT_EXPIRES_IN=7d

# The origin the browser loads the storefront from, with scheme and no trailing
# slash. Several may be listed, separated by commas. A request from anywhere
# else is refused by CORS, and a preflight from an unlisted origin answers 403.
CLIENT_ORIGIN=https://shop.example.com

# How much of the forwarding headers to believe, which decides what the rate
# limiter counts and what the log names:
#   empty            the internet reaches this process directly
#   1                exactly one reverse proxy or load balancer in front
#   loopback,10.0.0.0/8   a comma-separated list of addresses and subnets
# Trusting more hops than exist lets a caller forge its own address and spend
# somebody else's rate-limit allowance.
TRUST_PROXY=1

# Comma-separated addresses allowed through the admin-only middleware. Empty
# means no account is an administrator, which is the right default.
ADMIN_EMAILS=

# Where uploaded review photographs are written and served from. Point this at a
# directory that survives a restart — a mounted volume, or a bucket through the
# platform's own filesystem mount. A container's own filesystem does not.
UPLOAD_DIR=/var/lib/ziyo/uploads

# How much the server prints: debug, info, warn, error, or silent. `info` is the
# default and prints boots, shutdowns, refusals, failures, and slow or failed
# requests; healthy traffic is never printed.
LOG_LEVEL=info

# Where failures the server is responsible for are reported. Empty leaves them
# in the log alone. Only 5xx is posted, and the body carries the code, the route,
# and one stack frame — never the request, its headers, or the customer's data.
ERROR_REPORT_URL=
