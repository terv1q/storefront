# Server
NODE_ENV=development
PORT=4000
# Origins allowed by CORS. Several may be listed, separated by commas. This is
# the storefront's own address; development also accepts any localhost origin.
CLIENT_ORIGIN=http://localhost:5173
# How much of the forwarding headers to believe, which decides what the rate
# limiter counts and what the log names. Leave empty when the internet reaches
# this process directly. Behind a reverse proxy or a load balancer set the
# number of proxies in front of it (`1`), or the addresses to trust as a
# comma-separated list (`loopback,10.0.0.0/8`). Trusting more hops than exist
# lets a caller forge its own address.
TRUST_PROXY=

# Database
DATABASE_URL=postgresql://storefront:storefront@localhost:5432/storefront?schema=public

# Auth
# The value below is for local development only. A production server refuses to
# start while JWT_SECRET still holds it, and requires at least 32 characters.
JWT_SECRET=change-me-in-local-development
# Lifetime of an access token: a number of seconds, or a value like 30s, 15m, 12h, 7d, 2w.
JWT_EXPIRES_IN=7d
# Comma-separated emails allowed through the admin-only middleware. Empty means
# no account is an administrator.
ADMIN_EMAILS=

# Uploads
# Where review photographs are written and served from. A relative path is
# resolved against the server package's working directory. The directory is
# created on demand, and a deployment should point this at a volume that
# survives a restart.
UPLOAD_DIR=uploads

# Logging
# How much the server prints: debug, info, warn, error, or silent. Left unset it
# is info — boots, shutdowns, refusals, failures, and requests that were slow or
# failed. Healthy traffic is never printed. Set it to debug to also see every
# request and every SQL statement.
# LOG_LEVEL=debug
