# Configuration for the Docker stack.
#
# Copy this file to `.env.docker` and fill in the two values marked below. The
# copy is ignored by git, which is the point: a password that is written in a
# repository is a password everybody who can read the repository has. Nothing
# here reaches a container except through the compose file, which reads this
# file when it is passed with `--env-file .env.docker`.
#
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker up --build
#
# The same values in the same shape are documented for a deployment that is not
# this stack in `README.md`, under "Running it".

# The database the stack creates and the API connects to. The user and the
# database name are chosen once, when the volume is first created: changing
# either afterwards means an empty volume or a manual rename inside Postgres.
POSTGRES_USER=storefront
POSTGRES_DB=storefront

# Required. There is no default, and the compose file refuses to start without
# it. Generate one with `openssl rand -base64 24`.
POSTGRES_PASSWORD=

# Required. The API refuses to start in production while this still holds the
# value from `.env.example`, and requires at least 32 characters. Generate one
# with `openssl rand -base64 48`.
JWT_SECRET=

# Lifetime of an access token: a number of seconds, or a value like 30s, 15m,
# 12h, 7d, 2w.
JWT_EXPIRES_IN=7d

# The origin the browser uses to reach the storefront. It has to match what a
# visitor types, because the API compares the request's Origin against it.
CLIENT_ORIGIN=http://localhost:8080

# Where the API is reached from the built client. Left at `/api`, nginx brings
# the API to the same origin and there is no second hostname to configure.
VITE_API_URL=/api

# Comma-separated addresses allowed through the admin-only middleware. Empty
# means no account is an administrator.
ADMIN_EMAILS=

# How much the server prints: debug, info, warn, error, or silent.
LOG_LEVEL=info

# Ports on the host. The web server is the only one published by default.
CLIENT_PORT=8080
ADMINER_PORT=8081
# POSTGRES_PORT=5432
