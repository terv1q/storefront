# Dependencies
node_modules/
.pnpm-store/

# Environment
.env
.env.local
.env.*.local
# The Docker stack's own configuration, which holds the database password and
# the token secret. The example beside it is committed; the copy is not.
.env.docker
.env.production
!.env.example
!.env.docker.example
!.env.production.example

# Private development notes (not for the repository)
DEVELOPMENT_PLAN.md
# Generated by the commit-preparation pass, so the commands in it stay local.
commit_commands.txt

# Build output
dist/
build/
client/dist/
server/dist/
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# Test artifacts
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/

# Caches
.cache/
.turbo/
.eslintcache
.prettiercache
.vite/

# IDE and editors
.vscode/
.idea/
*.swp
*.swo
*.iml

# Local tool configuration: the assistant's own settings and the MCP servers
# this machine happens to have registered. Neither is part of the application and
# neither is the same for two people working on it. The Docker build already
# excludes the same paths.
.claude/settings.local.json
.mcp.json

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Local database files
server/prisma/*.db
server/prisma/*.db-journal

# Uploaded review photographs, written at runtime. The directory is recreated on
# demand, and a deployment keeps its own copy outside the repository.
server/uploads/
